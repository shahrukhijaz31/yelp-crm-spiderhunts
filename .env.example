# Lead Portal — environment variables.
#
# These are ALL of them. The app reads exactly two things from the environment
# (`grep -rn "process.env" app components lib` to confirm): DATABASE_URL, and
# NODE_ENV which Next sets itself. There are no NEXT_PUBLIC_* variables, so
# nothing is inlined into the browser bundle and nothing here reaches a client.
#
# LOCAL DEVELOPMENT
#   cp .env.example .env.local     (.env.local is gitignored; this file is not)
#
# PRODUCTION
#   Do not use a file in the release directory. deploy/provision.sh writes
#   /etc/lead-portal/env, owned by root and mode 600, which systemd injects via
#   EnvironmentFile. The app user cannot read it, and it survives deploys
#   because it lives outside the release tree.

# --- Required --------------------------------------------------------------

# PostgreSQL connection string.
#
# Local: create the database first — `createdb lead_portal`.
# If the password contains @ : / ? or #, percent-encode it (@ -> %40, # -> %23).
#
# Production adds `connection_limit`: Prisma's default pool is
# (physical_cpus * 2 + 1) per process, and with two blue/green slots briefly
# running at once that can exceed Postgres's default max_connections of 100.
#   postgresql://leadportal:PASSWORD@localhost:5432/lead_portal?schema=public&connection_limit=10
# For a hosted database, append `&sslmode=require`.
DATABASE_URL="postgresql://postgres:CHANGEME@localhost:5432/lead_portal?schema=public"


# --- Set by the platform, listed here so the full set is visible -----------

# `next build` and the standalone server set this themselves; systemd also sets
# it explicitly in /etc/lead-portal/env. Never set it in .env.local — doing so
# makes `next dev` behave as production and silently disables hot reload.
# NODE_ENV=production

# Which interface the standalone server binds to. Production pins this to
# loopback so nginx is the only route in and the Basic Auth in front of it
# cannot be bypassed by connecting to the port directly. Unset in development,
# where Next binds all interfaces for device testing.
# HOSTNAME=127.0.0.1

# Port for the standalone server. Set per blue/green slot on the VPS
# (/etc/lead-portal/slot-blue.env = 3001, slot-green.env = 3002).
# Development uses Next's default 3000.
# PORT=3001
