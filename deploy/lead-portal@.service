# Lead Portal — systemd template unit, one instance per colour slot.
#
# Install to /etc/systemd/system/lead-portal@.service, then run one instance per
# slot: `systemctl start lead-portal@blue`, `lead-portal@green`.
#
# Why a template and not a single unit: deploys are blue/green. The new release
# is started and health-checked on its own port *while the old one is still
# serving*, and nginx is only pointed at it once it answers. A single unit would
# mean stop-then-start, which is a visible outage on every deploy no matter how
# short. See deploy/deploy.sh.
#
# systemd rather than PM2 because this is the only Node process on the box: PM2
# would add a second supervisor that itself needs supervising, plus its own log
# rotation and startup-script generation. systemd is already PID 1 here, already
# starts on boot, and already has journald. deploy/ecosystem.config.cjs is
# provided for the case where you would rather use PM2 anyway.

[Unit]
Description=Lead Portal (Next.js) — %i slot
Documentation=https://github.com/shahrukhijaz31/yelp-crm-spiderhunts
After=network-online.target postgresql.service
Wants=network-online.target
# Not Requires=: if Postgres is briefly down the app should stay up and serve
# its own 503 from /api/health rather than being torn down by systemd.
After=postgresql.service

[Service]
Type=simple
User=leadportal
Group=leadportal

# Next's standalone server.js resolves everything relative to its own directory.
WorkingDirectory=/var/www/lead-portal/%i/.next/standalone

# Shared secrets first, then the per-slot PORT. Later files win, which is what
# lets both slots share one DATABASE_URL while listening on different ports.
EnvironmentFile=/etc/lead-portal/env
EnvironmentFile=/etc/lead-portal/slot-%i.env

ExecStart=/usr/bin/node server.js

Restart=always
RestartSec=2
# Five failures inside a minute means the release is broken, not flaky; stop
# restarting so `systemctl is-active` reports the truth and the deploy aborts.
StartLimitBurst=5
StartLimitIntervalSec=60

# Logs go to stdout/stderr -> journald. The app already writes structured-enough
# lines (console.error with a route prefix); journald adds timestamps, the unit
# name and the slot, and handles rotation. Read them with:
#   journalctl -u lead-portal@blue -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lead-portal-%i

# --- Hardening -------------------------------------------------------------
# The process needs to do exactly three things: read its own release directory,
# open a TCP connection to Postgres, and listen on a loopback port.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# ProtectSystem=strict makes the whole filesystem read-only; Next still wants to
# write its runtime cache, so that one directory is punched back out.
ReadWritePaths=/var/www/lead-portal/%i/.next

# A runaway render loop should kill this process, not the database next to it.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
