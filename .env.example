# Copy to .env.local and fill in. `.env.local` is gitignored; this file is not.
#
# Postgres running locally. Create the database once before the first
# migration:
#
#   createdb lead_portal          # or, from psql:  CREATE DATABASE lead_portal;
#
# If the password contains @ : / or ?, percent-encode it (@ -> %40).
# For a hosted instance, append &sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lead_portal?schema=public"
