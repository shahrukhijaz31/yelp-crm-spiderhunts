// Prisma schema for the Leads Portal.
//
// The model here mirrors `lib/types.ts` exactly — that file stays the single
// source of truth for the app, and `lib/leadDb.ts` maps rows onto it. Prisma
// field names are camelCase (so queries read like the TS type) while the
// columns are snake_case via `@map`.
//
// Generator/datasource shape is Prisma 7: the client is generated into the
// repo at `lib/generated/prisma`, the connection string lives in
// `prisma.config.ts`, and the runtime connects through the `@prisma/adapter-pg`
// driver adapter rather than a bundled query engine.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Mirrors the `CallStatus` union in `lib/types.ts`. The values are the same
/// snake_case keys the UI already stores, so no translation layer is needed;
/// the human labels ("Called - No answer") stay in `CALL_STATUS_LABELS`, which
/// keeps copy changes out of the database.
enum CallStatus {
  not_called
  no_answer
  voicemail
  /// Added after the initial migration, and declared here in the same position
  /// the migration inserts it into (`ADD VALUE ... AFTER 'voicemail'`) — an
  /// enum's declaration order is its sort order in Postgres, so the two lists
  /// have to agree or a later `prisma migrate diff` sees a change that is not.
  owner_not_available
  interested
  not_interested
  do_not_call
  bad_number

  @@map("call_status")
}

model Lead {
  /// cuid rather than an auto-increment int: leads get referenced from exports
  /// and (later) external systems, so the id must be safe to hand out and not
  /// leak row counts.
  id String @id @default(cuid())

  // --- Scraped fields (match the scraper CSV columns) ---
  name       String
  /// Never null in the UI — an absent address is the empty string.
  address    String   @default("")
  /// The CSV `categories` column is a list, and the UI renders it as one, so
  /// it is stored as a Postgres text[] instead of being flattened to a string.
  categories String[] @default([])
  /// Nullable to match the type, though `cleanLeads` means stored rows have one.
  phone      String?
  website    String?
  rating     Float?
  owner      String?
  /// Yelp listing URL — present in the scraper CSV and in the export.
  url        String?

  // --- Agent-owned fields ---
  status       CallStatus @default(not_called)
  notes        String     @default("")
  /// Date only: the UI works in `YYYY-MM-DD` strings and never has a time here.
  callbackDate DateTime?  @map("callback_date") @db.Date

  // --- Meeting detail, layered on top of callbackDate (see lib/meetings.ts) ---
  /// 24-hour `HH:MM`. A string, not a `time` column: it is a label on the
  /// callback date rather than an instant, and a real time type would invite a
  /// timezone conversion that must never happen here.
  meetingTime        String?   @map("meeting_time")
  meetingAttendees   String?   @map("meeting_attendees")
  meetingNotes       String    @default("") @map("meeting_notes")
  meetingCompletedAt DateTime? @map("meeting_completed_at") @db.Date

  // --- Provenance / bookkeeping ---
  /// Written by server-side duplicate detection. Nothing sets it to true yet —
  /// today `cleanLeads` drops repeats at ingest — but the column exists so that
  /// change has somewhere to write without another migration.
  isDuplicate Boolean  @default(false) @map("is_duplicate")
  /// Which CSV upload a row came from, so an import can be traced or filtered.
  sourceBatch String?  @map("source_batch")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// The call recording attached to this lead's meeting, if one has been
  /// uploaded. At most one — see `MeetingRecording`.
  recording MeetingRecording?

  /// Indexes follow the queries the UI actually runs: the stat bar and filters
  /// group by status, the Callbacks/Meetings views range-scan on callbackDate,
  /// and the import view scopes by batch. There is deliberately no unique
  /// constraint on phone — duplicate handling is a flag (`isDuplicate`), not a
  /// database rejection, so a repeat can be surfaced rather than refused.
  @@index([status])
  @@index([callbackDate])
  @@index([sourceBatch])
  @@index([isDuplicate])
  @@map("leads")
}

/// A phone-call recording attached to a meeting.
///
/// "Meeting" is not a table in this app: membership of the Meetings view is
/// derived from the lead itself (`lib/meetings.ts` — interested, or a date in
/// the diary), so the meeting a recording belongs to *is* a lead, and the
/// foreign key says so. Inventing a `meetings` table to hold this one column
/// would mean two sources of truth for what is on the agenda, and the derived
/// one would win every time.
///
/// **The audio is not here.** Only the metadata is: the bytes live under the
/// storage root (`lib/recordingStorage.ts`) addressed by `storageKey`. A 25MB
/// bytea per meeting would be carried by every backup, every `pg_dump` and —
/// on a careless `SELECT *` — into application memory, to buy nothing that a
/// file on disk does not already give.
///
/// One recording per meeting (`leadId` is unique). Replacing is genuinely
/// replacing: the row is overwritten and the old object deleted, so there is
/// no quiet accumulation of superseded audio that nobody can see but everybody
/// is still storing.
model MeetingRecording {
  id String @id @default(cuid())

  /// The meeting. Cascade because a recording of a lead that no longer exists
  /// is unreachable by design — nothing can authorize access to it.
  leadId String @unique @map("lead_id")
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Who uploaded it. This is the authorization subject, not a display field:
  /// an agent may reach a recording only through this column matching their
  /// own id (`lib/recordings.ts`). Restrict, not cascade — accounts here are
  /// disabled rather than deleted, and a delete that silently took evidence
  /// of client calls with it would be the wrong default.
  uploadedById String @map("uploaded_by_user_id")
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  /// The agent's original filename, kept only to show them what they sent. It
  /// never reaches the filesystem: `storageKey` is server-generated, so a
  /// name like `../../etc/passwd` is a label and nothing more.
  fileName String @map("file_name")
  /// Server-decided content type, from the sniffed magic bytes rather than the
  /// browser's claim. Sent back as `Content-Type` when streaming.
  fileType String @map("file_type")
  /// Bytes actually written, measured server-side.
  fileSize Int    @map("file_size")

  /// Path of the object beneath the storage root, e.g. `2026/08/<random>.mp3`.
  /// Unique so two rows can never point at one file and have a delete of the
  /// first orphan the second.
  storageKey String @unique @map("storage_key")

  /// Whole seconds, as read from the audio in the browser. Metadata only — it
  /// is displayed, never used to decide anything — and clamped on the way in,
  /// because it is the one field here the client is the source of.
  durationSeconds Int? @map("duration_seconds")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The admin view lists "meetings with a recording" newest first, and the
  /// agent view filters to their own uploads.
  @@index([uploadedById])
  @@index([createdAt])
  @@map("meeting_recordings")
}

/// Exactly two roles, and every user has one. ADMIN is the full portal; AGENT
/// is the day job — the worklist and meetings — with export, import, reports,
/// settings and user management withheld.
///
/// An enum rather than a string column: Postgres rejects a value outside this
/// set, so a bad write fails at the database rather than becoming a role the
/// authorization code has never heard of and does not know how to refuse.
enum UserRole {
  ADMIN
  AGENT

  @@map("user_role")
}

/// A person who can sign in.
///
/// The database is the only source of truth for `role` and `isActive`. Nothing
/// the browser sends is ever consulted when deciding what someone may do — the
/// session cookie carries an opaque token and nothing else, so a tampered
/// cookie cannot describe a role.
model User {
  id String @id @default(cuid())

  /// Sign-in identifiers. Both are accepted at the login form and both are
  /// stored lower-cased, so `Admin` and `admin` cannot become two accounts.
  username String @unique
  email    String @unique
  name     String

  /// scrypt, salted per user, in the format written by `lib/password.ts`.
  /// Never selected into anything that leaves the server.
  passwordHash String @map("password_hash")

  role UserRole @default(AGENT)

  /// Disabling is preferred over deleting: it keeps the audit trail of who did
  /// what to a lead intact while ending access immediately. Checked on every
  /// request, not just at login, so disabling takes effect at once.
  isActive Boolean @default(true) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sessions Session[]
  /// Call recordings this person uploaded. The back-reference exists so that
  /// "who uploaded this" is a join rather than a second lookup, and so the
  /// Restrict on the far side is visible from here: a user holding recordings
  /// cannot be deleted out from under them.
  recordings MeetingRecording[]

  @@map("users")
}

/// A signed-in browser.
///
/// Server-side sessions rather than a self-contained signed token, because
/// logout has to be real: deleting the row ends the session everywhere at
/// once, and a stolen cookie replayed after logout finds nothing. A JWT would
/// stay valid in an attacker's hands until it expired, whatever the app did.
///
/// Only the SHA-256 of the token is stored. The plaintext exists solely in the
/// user's cookie, so a leaked database dump does not hand over live sessions.
model Session {
  id String @id @default(cuid())

  /// SHA-256 hex of the cookie value. Unique, so a token maps to one session.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  /// Cascade: deleting a user ends their sessions in the same statement, so an
  /// account cannot be removed while a live cookie for it still works.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Idle expiry, pushed forward as the session is used (see `lib/session.ts`).
  expiresAt         DateTime @map("expires_at")
  /// Hard ceiling set at sign-in. Rolling expiry can never move past this, so
  /// a permanently-open tab still has to re-authenticate eventually.
  absoluteExpiresAt DateTime @map("absolute_expires_at")

  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  /// User agent and IP as they were at sign-in — enough to recognise a session
  /// in a list, deliberately not enough to be a tracking log.
  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
