// Prisma schema for the Leads Portal.
//
// The model here mirrors `lib/types.ts` exactly — that file stays the single
// source of truth for the app, and `lib/leadDb.ts` maps rows onto it. Prisma
// field names are camelCase (so queries read like the TS type) while the
// columns are snake_case via `@map`.
//
// Generator/datasource shape is Prisma 7: the client is generated into the
// repo at `lib/generated/prisma`, the connection string lives in
// `prisma.config.ts`, and the runtime connects through the `@prisma/adapter-pg`
// driver adapter rather than a bundled query engine.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Mirrors the `CallStatus` union in `lib/types.ts`. The values are the same
/// snake_case keys the UI already stores, so no translation layer is needed;
/// the human labels ("Called - No answer") stay in `CALL_STATUS_LABELS`, which
/// keeps copy changes out of the database.
enum CallStatus {
  not_called
  no_answer
  voicemail
  /// Added after the initial migration, and declared here in the same position
  /// the migration inserts it into (`ADD VALUE ... AFTER 'voicemail'`) — an
  /// enum's declaration order is its sort order in Postgres, so the two lists
  /// have to agree or a later `prisma migrate diff` sees a change that is not.
  owner_not_available
  interested
  not_interested
  do_not_call
  bad_number

  @@map("call_status")
}

model Lead {
  /// cuid rather than an auto-increment int: leads get referenced from exports
  /// and (later) external systems, so the id must be safe to hand out and not
  /// leak row counts.
  id String @id @default(cuid())

  // --- Scraped fields (match the scraper CSV columns) ---
  name       String
  /// Never null in the UI — an absent address is the empty string.
  address    String   @default("")
  /// The CSV `categories` column is a list, and the UI renders it as one, so
  /// it is stored as a Postgres text[] instead of being flattened to a string.
  categories String[] @default([])
  /// Nullable to match the type, though `cleanLeads` means stored rows have one.
  phone      String?
  website    String?
  rating     Float?
  owner      String?
  /// Yelp listing URL — present in the scraper CSV and in the export.
  url        String?

  // --- Agent-owned fields ---
  status        CallStatus @default(not_called)
  /// When this lead was first *worked* — stamped the moment an agent saves a
  /// call outcome, and never cleared or moved afterwards.
  ///
  /// This is what splits the worklist into New and Called, and it is a column
  /// rather than a re-reading of `status` because the two answer different
  /// questions. `status` is where the lead stands *now* and an agent may move
  /// it anywhere, including back to `not_called`; this records that the call
  /// happened at all, which is not something a later edit can un-happen. Using
  /// `status != 'not_called'` for the split would quietly return a worked lead
  /// to the New queue the moment someone corrected a mis-click, and the agent
  /// would call it again.
  ///
  /// Null means never called. Nothing in the app writes null over a non-null
  /// value — see `updateLeadFields`.
  ///
  /// *When* it was last worked is `updatedAt`, which already tracks exactly
  /// that; the Called list orders by it rather than carrying a second
  /// timestamp that would have to be kept in step by hand.
  firstCalledAt DateTime?  @map("first_called_at")
  notes         String     @default("")
  /// Date only: the UI works in `YYYY-MM-DD` strings and never has a time here.
  callbackDate  DateTime?  @map("callback_date") @db.Date

  // --- Meeting detail, layered on top of callbackDate (see lib/meetings.ts) ---
  /// 24-hour `HH:MM`. A string, not a `time` column: it is a label on the
  /// callback date rather than an instant, and a real time type would invite a
  /// timezone conversion that must never happen here.
  meetingTime        String?   @map("meeting_time")
  meetingAttendees   String?   @map("meeting_attendees")
  meetingNotes       String    @default("") @map("meeting_notes")
  meetingCompletedAt DateTime? @map("meeting_completed_at") @db.Date

  // --- Provenance / bookkeeping ---
  /// Written by server-side duplicate detection. Nothing sets it to true yet —
  /// today `cleanLeads` drops repeats at ingest — but the column exists so that
  /// change has somewhere to write without another migration.
  isDuplicate Boolean  @default(false) @map("is_duplicate")
  /// Which CSV upload a row came from, so an import can be traced or filtered.
  sourceBatch String?  @map("source_batch")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// The call recording attached to this lead's meeting, if one has been
  /// uploaded. At most one — see `MeetingRecording`.
  recording MeetingRecording?

  /// The log of who worked this lead and when. The lead itself keeps only the
  /// current outcome; this keeps every one of them, with a name against it.
  activity LeadActivity[]

  /// Indexes follow the queries the UI actually runs: the stat bar and filters
  /// group by status, the Callbacks/Meetings views range-scan on callbackDate,
  /// and the import view scopes by batch. There is deliberately no unique
  /// constraint on phone — duplicate handling is a flag (`isDuplicate`), not a
  /// database rejection, so a repeat can be surfaced rather than refused.
  @@index([status])
  /// The New/Called split is `IS NULL` / `IS NOT NULL` on this column, and it
  /// is now on every worklist query — including the two count queries behind
  /// the tab badges.
  @@index([firstCalledAt])
  @@index([callbackDate])
  @@index([sourceBatch])
  @@index([isDuplicate])
  @@map("leads")
}

/// A phone-call recording attached to a meeting.
///
/// "Meeting" is not a table in this app: membership of the Meetings view is
/// derived from the lead itself (`lib/meetings.ts` — interested, or a date in
/// the diary), so the meeting a recording belongs to *is* a lead, and the
/// foreign key says so. Inventing a `meetings` table to hold this one column
/// would mean two sources of truth for what is on the agenda, and the derived
/// one would win every time.
///
/// **The audio is not here.** Only the metadata is: the bytes live under the
/// storage root (`lib/recordingStorage.ts`) addressed by `storageKey`. A 25MB
/// bytea per meeting would be carried by every backup, every `pg_dump` and —
/// on a careless `SELECT *` — into application memory, to buy nothing that a
/// file on disk does not already give.
///
/// One recording per meeting (`leadId` is unique). Replacing is genuinely
/// replacing: the row is overwritten and the old object deleted, so there is
/// no quiet accumulation of superseded audio that nobody can see but everybody
/// is still storing.
model MeetingRecording {
  id String @id @default(cuid())

  /// The meeting. Cascade because a recording of a lead that no longer exists
  /// is unreachable by design — nothing can authorize access to it.
  leadId String @unique @map("lead_id")
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Who uploaded it. This is the authorization subject, not a display field:
  /// an agent may reach a recording only through this column matching their
  /// own id (`lib/recordings.ts`). Restrict, not cascade — accounts here are
  /// disabled rather than deleted, and a delete that silently took evidence
  /// of client calls with it would be the wrong default.
  uploadedById String @map("uploaded_by_user_id")
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  /// The agent's original filename, kept only to show them what they sent. It
  /// never reaches the filesystem: `storageKey` is server-generated, so a
  /// name like `../../etc/passwd` is a label and nothing more.
  fileName String @map("file_name")
  /// Server-decided content type, from the sniffed magic bytes rather than the
  /// browser's claim. Sent back as `Content-Type` when streaming.
  fileType String @map("file_type")
  /// Bytes actually written, measured server-side.
  fileSize Int    @map("file_size")

  /// Path of the object beneath the storage root, e.g. `2026/08/<random>.mp3`.
  /// Unique so two rows can never point at one file and have a delete of the
  /// first orphan the second.
  storageKey String @unique @map("storage_key")

  /// Whole seconds, as read from the audio in the browser. Metadata only — it
  /// is displayed, never used to decide anything — and clamped on the way in,
  /// because it is the one field here the client is the source of.
  durationSeconds Int? @map("duration_seconds")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The admin view lists "meetings with a recording" newest first, and the
  /// agent view filters to their own uploads.
  @@index([uploadedById])
  @@index([createdAt])
  @@map("meeting_recordings")
}

/// What an agent did to a lead, as one of a small closed set of *acts*.
///
/// Deliberately not "every field that changed": these are the four things the
/// business asks about at the end of a day, and each one maps to a decision an
/// agent actually made. Typing in the notes box is not on the list, because
/// nobody has ever wanted to know how many times a note was edited.
enum LeadActivityKind {
  /// A call outcome was saved — the same act that stamps `leads.first_called_at`
  /// (see `updateLeadFields`). This is the atom every "calls" and "leads worked"
  /// figure is counted from.
  call_logged
  /// A date was put in the diary with no time attached.
  callback_scheduled
  /// A date *and* a time — what the Book meeting dialog sends.
  meeting_booked
  /// A meeting was marked done.
  meeting_completed

  @@map("lead_activity_kind")
}

/// One thing one person did to one lead, at one instant.
///
/// **Why this table has to exist.** Nothing else in the schema records *who*
/// worked a lead. `leads` carries the outcome (`status`, `first_called_at`,
/// `updated_at`) but not the actor, and it is overwritten in place — the row
/// only ever remembers the most recent edit, by nobody in particular. So
/// "how many leads did Umar work today" is not a question the existing tables
/// can answer at any price, and no amount of aggregation over `leads` will
/// produce it. This is the minimum structure that makes per-agent reporting
/// derivable from real data rather than guessed at.
///
/// It is an append-only log, and that is the second reason it is not columns on
/// `leads`: a lead worked on Monday and again on Friday is two facts, and a
/// column can only hold one of them. Rows are never updated and never deleted
/// by the application.
///
/// **`status` is copied deliberately**, and it is not duplication of
/// `leads.status`. That column is where the lead stands *now* and moves
/// whenever anyone edits it; this is what the outcome *was* at this instant, so
/// a report of last week's calls does not silently rewrite itself when someone
/// corrects a status today. Reports read this column and never join back to the
/// lead for an outcome.
model LeadActivity {
  id String @id @default(cuid())

  /// Cascade: activity against a lead that no longer exists cannot be shown,
  /// filtered or attributed to anything, and the lead is what gives it meaning.
  leadId String @map("lead_id")
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Who did it. Restrict, matching `meeting_recordings` and `password_resets`:
  /// accounts here are disabled rather than deleted, and a delete that quietly
  /// took a month of someone's performance record with it would be exactly the
  /// wrong default for a table whose whole job is attribution.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  kind LeadActivityKind

  /// The call outcome as saved, for `call_logged` rows. Null on the other
  /// kinds, which are not outcomes.
  status CallStatus?

  createdAt DateTime @default(now()) @map("created_at")

  /// Every report is "this person, over this window" or "everyone, over this
  /// window", so the composite leads with the agent and the plain index on the
  /// clock serves the team-wide roll-up. `leadId` supports counting *distinct
  /// leads* worked, which is not the same as counting calls.
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([leadId, createdAt])
  @@map("lead_activities")
}

/// A stretch of time somebody was signed in and working.
///
/// **Not the same row as `sessions`.** That table is a *browser* — one row per
/// cookie, deleted at logout, and there are as many of them as the person has
/// devices and tabs open. This is a *shift*: at most one open row per user at
/// any moment, whatever they are browsing from, kept after it ends because the
/// whole point is to still have it at the end of the month. Reusing `sessions`
/// for both would mean either losing the record at logout (it is deleted) or
/// counting a second browser as a second working day.
///
/// **One open session per user, and that is how multiple tabs are handled.**
/// Signing in resumes the open session if there already is one rather than
/// opening a second (`openOrResumeWorkSession`), so a second tab, a second
/// window or a second browser adds no time at all — the clock is wall-clock
/// presence, counted once. The invariant is enforced in that one function,
/// inside a transaction, and the reconciliation sweep collapses any duplicate
/// that a genuinely simultaneous double sign-in could still produce.
///
/// **Crashes are bounded by `lastSeenAt`.** The browser heartbeats while the
/// portal is open; a session whose heartbeat stopped is closed at its last
/// heartbeat rather than at the moment anyone noticed, so a closed laptop costs
/// a few minutes of over-count and never a permanently running clock. Nothing
/// depends on the logout button being pressed.
///
/// **`lastSeenAt` is also the hook for real activity tracking.** Today the
/// heartbeat means "the portal is open", so the duration is authenticated
/// session time, which is what was asked for. If idle detection is added later
/// it changes what the heartbeat is *sent on*, and this table does not change.
model WorkSession {
  id String @id @default(cuid())

  /// Cascade: a deleted account's shifts have nobody to be reported for.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt  DateTime  @default(now()) @map("started_at")
  /// Last heartbeat from an open portal tab. Bounds the session if it dies.
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  /// Null while the session is open — the one column that says "still working".
  endedAt    DateTime? @map("ended_at")

  /// Whole seconds between `startedAt` and `endedAt`, written when the session
  /// closes. Stored rather than computed on read because it is what every
  /// report sums, and `SUM(duration_seconds)` over an indexed range beats
  /// subtracting two timestamps a million times. Null while open, where the
  /// live figure is `now() - started_at` and belongs to the clock, not the row.
  durationSeconds Int? @map("duration_seconds")

  /// How it ended, for reading the data later rather than for any decision the
  /// code makes: `logout` is the button, `timeout` is a heartbeat that stopped.
  endedReason String? @map("ended_reason")

  createdAt DateTime @default(now()) @map("created_at")

  /// Screenshots captured during this shift. The relation is what makes
  /// "show me what this agent was doing between 2pm and 4pm" a query rather
  /// than a join against two timestamps.
  screenshots Screenshot[]

  /// Keyboard/mouse activity observed *during* this shift. Note the direction
  /// of the dependency: an interval describes a session, and a session knows
  /// nothing about intervals. Nothing in `lib/activity.ts` writes to this table
  /// from the activity side — the shift's start, end and duration stay exactly
  /// what the portal decided they were.
  activityIntervals ActivityInterval[]

  /// Which applications were in the foreground during this shift. The direction
  /// of the dependency is the same one the intervals have: a usage row
  /// describes a session, and a session knows nothing about usage. Nothing in
  /// `lib/appUsage.ts` writes to this table.
  appUsage AppUsage[]

  /// Manual corrections an administrator has made to this shift. Kept even
  /// after the correction has been applied — the row above holds the current
  /// value, these hold every value it has ever had and who changed it.
  adjustments TimeAdjustment[]

  /// The two queries this table has: "the open session for this user"
  /// (`endedAt IS NULL`, hit on every page load) and "sessions overlapping this
  /// window" for the reports.
  @@index([userId, endedAt])
  @@index([userId, startedAt])
  @@index([startedAt])
  @@map("work_sessions")
}

/// Exactly two roles, and every user has one. ADMIN is the full portal; AGENT
/// is the day job — the worklist and meetings — with export, import, reports,
/// settings and user management withheld.
///
/// An enum rather than a string column: Postgres rejects a value outside this
/// set, so a bad write fails at the database rather than becoming a role the
/// authorization code has never heard of and does not know how to refuse.
enum UserRole {
  ADMIN
  AGENT

  @@map("user_role")
}

/// A person who can sign in.
///
/// The database is the only source of truth for `role` and `isActive`. Nothing
/// the browser sends is ever consulted when deciding what someone may do — the
/// session cookie carries an opaque token and nothing else, so a tampered
/// cookie cannot describe a role.
model User {
  id String @id @default(cuid())

  /// Sign-in identifiers. Both are accepted at the login form and both are
  /// stored lower-cased, so `Admin` and `admin` cannot become two accounts.
  username String @unique
  email    String @unique
  name     String

  /// scrypt, salted per user, in the format written by `lib/password.ts`.
  /// Never selected into anything that leaves the server.
  passwordHash String @map("password_hash")

  role UserRole @default(AGENT)

  /// Disabling is preferred over deleting: it keeps the audit trail of who did
  /// what to a lead intact while ending access immediately. Checked on every
  /// request, not just at login, so disabling takes effect at once.
  isActive Boolean @default(true) @map("is_active")

  /// Set when an administrator issues a reset code, cleared the moment the
  /// person chooses a new password. It is a *state*, not a permission: the
  /// account's password hash is scrambled at the same moment the flag goes up,
  /// so the flag is what explains the lockout rather than what causes it.
  requirePasswordChange Boolean @default(false) @map("require_password_change")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sessions             Session[]
  /// Reset codes issued *for* this account, and (the second relation) the ones
  /// this administrator issued for other people.
  passwordResets       PasswordReset[]    @relation("PasswordResetSubject")
  passwordResetsIssued PasswordReset[]    @relation("PasswordResetIssuer")
  /// Call recordings this person uploaded. The back-reference exists so that
  /// "who uploaded this" is a join rather than a second lookup, and so the
  /// Restrict on the far side is visible from here: a user holding recordings
  /// cannot be deleted out from under them.
  recordings           MeetingRecording[]

  /// What this person did, and when they were signed in to do it. Both are the
  /// raw material of every performance figure in the portal; neither is ever
  /// read for anyone but the caller unless the caller is an administrator.
  activity     LeadActivity[]
  workSessions WorkSession[]

  /// Second-factor codes issued to this account's registered email during a
  /// sign-in that has passed the password step but not yet finished.
  loginOtps LoginOtp[]

  /// Workstations running the SpiderHunts Monitor desktop application that
  /// this agent has connected. Not sessions — see `MonitorDevice`.
  monitorDevices MonitorDevice[]

  /// Desktop screenshots captured by those workstations.
  screenshots Screenshot[]

  /// Aggregate keyboard/mouse activity observed during this person's shifts.
  /// Counts only — see `ActivityInterval` for what is deliberately absent.
  activityIntervals ActivityInterval[]

  /// Which applications held the foreground during those shifts, and for how
  /// long. Admin-only on the read side — see `lib/access.ts`.
  appUsage AppUsage[]

  /// Manual time corrections: the ones made *to* this person's shifts, and (the
  /// second relation) the ones this administrator made to other people's. The
  /// second is `Restrict` on the far side, which is why it is visible from here.
  timeAdjustments     TimeAdjustment[] @relation("TimeAdjustmentSubject")
  timeAdjustmentsMade TimeAdjustment[] @relation("TimeAdjustmentAdmin")

  /// The productivity configuration, when this administrator was the last to
  /// change it. A back-reference to one row at most — see
  /// {@link ProductivitySettings}, which is a singleton.
  productivitySettings ProductivitySettings[]

  @@map("users")
}

/// The targets and weights the productivity score is calculated against.
///
/// **Why this is a table and not an environment variable.** Every other
/// server-owned number in this application — the activity cadence, the idle
/// threshold, the screenshot rate limit — lives in `process.env`, and
/// `lib/activityPolicy.ts` argues at length that this is right: an agent must
/// not be able to change how they are measured, and a root-owned env file
/// cannot be reached from any request at all.
///
/// That argument still holds for *activity*, and it is exactly why this is a
/// different thing. Those numbers are a calibration nobody is meant to tune;
/// these are a management decision that the brief requires an administrator to
/// be able to make from the portal, which means there has to be a write path,
/// which means it cannot be an environment variable. What makes that safe is
/// the same thing that makes `time_adjustments` safe: the write is behind
/// `apiAdmin()`, and the row records who made it.
///
/// **One row, forever.** The id defaults to the literal `default` and the only
/// write path is an upsert on it, so there is no "which configuration is
/// current" question to answer and no way to accumulate a second one. Reports
/// read this row as it stands *now*, including reports about last month — see
/// the note on `lib/productivityRules.ts`. Keeping a history of weights and
/// resolving each report against the configuration in force at the time was
/// considered and rejected: it makes two reports of the same period disagree
/// for reasons invisible on the screen, and the brief asks for the simple and
/// predictable behaviour.
///
/// **No agent data is stored here and none is derived from it.** Productivity
/// is computed on read from `lead_activities`, `work_sessions` and
/// `activity_intervals`; there is deliberately no table of scores, because a
/// stored score is a copy of data that already exists and would be wrong the
/// moment a target changed.
model ProductivitySettings {
  /// Always `default`. The singleton's whole enforcement mechanism.
  id String @id @default("default")

  /// Per-agent, per-worked-day expectations. Whole positive numbers; the
  /// activity target is a percentage. Validated in `lib/productivityRules.ts`,
  /// which is the only thing that writes here.
  callsTarget     Int @default(50) @map("calls_target")
  leadsTarget     Int @default(40) @map("leads_target")
  meetingsTarget  Int @default(5) @map("meetings_target")
  followUpsTarget Int @default(30) @map("follow_ups_target")
  activityTarget  Int @default(80) @map("activity_target")

  /// Percentage points, and they must total exactly 100. Stored as whole
  /// numbers rather than fractions so the configuration screen, the breakdown
  /// on the agent detail view and the row in the database all show the same
  /// figure with no rounding between them.
  callsWeight     Int @default(30) @map("calls_weight")
  leadsWeight     Int @default(25) @map("leads_weight")
  meetingsWeight  Int @default(25) @map("meetings_weight")
  activityWeight  Int @default(10) @map("activity_weight")
  followUpsWeight Int @default(10) @map("follow_ups_weight")

  /// Who last changed it, for the same reason `time_adjustments` records an
  /// admin: a number that decides how people are appraised should not be
  /// anonymous. `SetNull` rather than `Restrict` — this is a label on a
  /// configuration row, not an audit trail of a correction, and it must not be
  /// the reason an account cannot be removed.
  updatedById String? @map("updated_by_user_id")
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// No indexes. One row, read by primary key.
  @@map("productivity_settings")
}

/// A workstation running the SpiderHunts Monitor desktop application.
///
/// **Why this is not a row in `sessions`.** It was the obvious first idea, and
/// it is wrong for a specific, load-bearing reason: `endWorkSessionForLogout`
/// decides whether to stop an agent's shift clock by *counting the live rows in
/// `sessions`*. A desktop client that stays connected all day would be one of
/// them, so signing out of the browser would never close the shift, and every
/// agent's day would run until the staleness sweep or midnight. The clock would
/// be quietly, permanently wrong — in the direction of over-reporting hours.
/// Keeping the desktop credential in its own table means `sessions` still
/// contains exactly what that function believes it contains: browsers.
///
/// The same separation answers the second requirement: connecting the Monitor
/// must not start a shift, and cannot, because nothing on this path calls
/// `completeSignIn`. The Monitor *observes* the work session (`getWorkClock`)
/// and never opens, extends or closes one. The portal remains the only thing
/// that decides whether an agent is working.
///
/// **Two tokens, one row.** A short-lived access token is what every request
/// carries; a long-lived refresh token buys a new pair. Both are 32 random
/// bytes stored only as their SHA-256 — the identical construction `sessions`
/// uses, and for the identical reason: a database dump yields nothing
/// replayable. There is no JWT and therefore no signing secret to distribute or
/// rotate, which keeps the promise `.env.example` makes that authentication
/// adds no environment variables.
///
/// **Refresh rotates.** Every refresh writes a new pair and the old refresh
/// token stops working immediately, so a token captured from disk is useful
/// only until the device next refreshes — and the rotation is what makes a
/// stolen copy detectable rather than silently permanent.
model MonitorDevice {
  id String @id @default(cuid())

  /// Whose workstation. Cascade: a deleted account's devices can authenticate
  /// as nobody. Role is *not* copied here — it is read from `users` on every
  /// single request, exactly as the web session does, so an agent promoted or
  /// demoted is treated correctly on their next call rather than at next login.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 hex of the current access token. Nullable and unique: null once
  /// the device is revoked or its access token has been superseded, unique so
  /// one token can never resolve to two devices.
  accessTokenHash String?   @unique @map("access_token_hash")
  /// Short — minutes, not hours. A leaked access token expires on its own.
  accessExpiresAt DateTime? @map("access_expires_at")

  /// SHA-256 hex of the current refresh token. Replaced on every refresh.
  refreshTokenHash String   @unique @map("refresh_token_hash")
  /// Hard ceiling on the device's connection. Never extended by a refresh, so a
  /// workstation nobody has touched for a month must sign in again.
  refreshExpiresAt DateTime @map("refresh_expires_at")

  /// Set when the agent signs out of the Monitor, or when an administrator
  /// disables the account. A revoked row is kept rather than deleted so a
  /// replayed token finds "revoked" instead of no row at all.
  revokedAt DateTime? @map("revoked_at")

  /// Enough to recognise a workstation in a list. The hostname is supplied by
  /// the client and is a label only — nothing is ever authorized by it.
  deviceName String? @map("device_name")
  platform   String?
  appVersion String? @map("app_version")

  /// Last authenticated request from this device. Not a heartbeat for the work
  /// session — that stays entirely the portal's business.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  /// When this workstation last had a screenshot **accepted**, and the whole of
  /// the upload rate limit's state (`lib/screenshotRateLimit.ts`).
  ///
  /// A column here rather than a derived read of `screenshots`, because the
  /// limit has to be claimed *before* anything is stored — no file, no row —
  /// and because a single conditional `UPDATE` against this one column is
  /// atomic across every application instance without a lock, a queue or Redis.
  /// Two processes racing the same device: one matches the `WHERE`, the other
  /// updates zero rows and is refused.
  ///
  /// Written from the server's clock only. Nothing a client sends can move it,
  /// which is what stops a workstation with a doctored `capturedAt` — or a
  /// doctored anything — from buying itself extra uploads.
  lastScreenshotAt DateTime? @map("last_screenshot_at")

  /// Screenshots this workstation uploaded. Nullable on the far side — see the
  /// note on `Screenshot.deviceId`.
  screenshots Screenshot[]

  /// Foreground application usage this workstation reported. Nullable on the
  /// far side for the identical reason.
  appUsage AppUsage[]

  /// "This user's devices" for revocation, and the clock for the housekeeping
  /// sweep. Token lookups already ride the two unique indexes.
  @@index([userId])
  @@index([refreshExpiresAt])
  @@map("monitor_devices")
}

/// One desktop screenshot, captured by a workstation during a work session.
///
/// **The image is not here.** Only its metadata is: the bytes live under the
/// storage root (`lib/screenshotStorage.ts`) addressed by `storageKey`, for
/// exactly the reasons `MeetingRecording` gives — a few hundred kilobytes of
/// bytea per screenshot, several times an hour, per agent, would be carried by
/// every backup and every `pg_dump`, and would arrive in application memory on
/// any careless `SELECT *`. Screenshots are the highest-volume thing this
/// application will ever store; they belong on a filesystem.
///
/// **Everything identifying is server-derived.** `userId` comes from the
/// monitor device the request authenticated as, and `workSessionId` from the
/// portal's own view of that user's open shift — neither is read from the
/// upload. An agent cannot file a screenshot against someone else's account or
/// someone else's shift, because there is no field in the request that says who
/// it belongs to.
model Screenshot {
  id String @id @default(cuid())

  /// Whose desktop this is. Cascade: a deleted account's screenshots have
  /// nobody to be shown for, and keeping images of a person whose record has
  /// been erased is the wrong default for a monitoring system.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The shift it was taken during. Required, not optional: a screenshot with
  /// no work session is a screenshot taken while the agent was not working, and
  /// the upload route refuses to create one. Cascade for the same reason as
  /// above — `work_sessions` rows are only ever deleted with their user.
  workSessionId String      @map("work_session_id")
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)

  /// Which workstation uploaded it, for auditability.
  ///
  /// Nullable with `SetNull`, deliberately. Device rows are disposable — they
  /// are revoked on sign-out and *deleted* by the housekeeping sweep once their
  /// refresh ceiling has passed — and a screenshot must outlive the laptop it
  /// came from. Cascade here would mean an agent signing out and their tokens
  /// ageing out silently deleted a month of evidence; Restrict would mean the
  /// sweep could never delete a device again.
  deviceId String?        @map("monitor_device_id")
  device   MonitorDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  /// When the shutter fired on the workstation, as the client reported it.
  /// Clamped server-side to a window around the server's own clock — see
  /// `lib/screenshotRules.ts`. `createdAt` is when the server received it, and
  /// the two together are what expose a workstation with a wrong clock.
  capturedAt DateTime @map("captured_at")

  /// Path of the object beneath the storage root, e.g.
  /// `2026/08/11/<user id>/<timestamp>-<random>.jpg`. Unique, so two rows can
  /// never point at one file and have a delete of the first orphan the second.
  storageKey String @unique @map("storage_key")

  /// Real pixels, read out of the JPEG itself rather than taken from the
  /// client's claim (`lib/screenshotRules.ts`).
  width  Int
  height Int

  /// Bytes actually written, measured server-side.
  fileSize Int @map("file_size")

  /// Sniffed from the magic bytes. `image/jpeg` today; the column exists so a
  /// later format needs no migration.
  format String

  /// The workstation's display identifier.
  ///
  /// **A string, not an integer.** Electron's `Display.id` is a 64-bit value in
  /// practice — the panel on the first workstation this was tested against
  /// reports `2528732444`, which overflows Postgres `integer`. It is an opaque
  /// label that is only ever compared for equality, so it is stored as text and
  /// the question does not arise again.
  displayId String @map("display_id")

  createdAt DateTime @default(now()) @map("created_at")

  /// The queries the viewer will run: one agent's screenshots newest first,
  /// everything from one shift, and a time range across everybody.
  @@index([userId, capturedAt])
  @@index([workSessionId, capturedAt])
  @@index([capturedAt])
  @@map("screenshots")
}

/// A minute of keyboard and mouse activity, as counts and nothing else.
///
/// **What is deliberately not here.** No keystrokes, no typed text, no key
/// names, no mouse coordinates, no clipboard, no window titles, no URLs. Two
/// integers — how many keyboard events and how many mouse events — and the
/// window they were observed in. That is not a limitation of the current
/// implementation that a later one might lift: it is the whole design, and the
/// columns below are the only place activity data has to go, so there is nowhere
/// for a keystroke to be stored even if something tried to send one.
///
/// **It describes a shift; it does not make one.** `work_sessions` remains the
/// sole authority on when somebody was working — its start, its end, its
/// duration and its open/stale state are decided by the portal and by nothing
/// here. An interval is an observation *inside* a shift that already existed,
/// and `lib/activity.ts` refuses a submission that has no open shift to attach
/// to rather than inventing one. Total tracked time is therefore summed from
/// `work_sessions`, never from these rows; these say how much of that time had
/// input in it.
///
/// **`activity_percentage` is computed by the server.** The desktop client may
/// send one and it is ignored — see `lib/activityRules.ts`. It is a share of a
/// configured expected-events rate, it is called activity because that is what
/// it measures, and it is not a measure of productivity.
///
/// **`client_key` is the idempotency key**, and the unique constraint below is
/// the whole of the duplicate protection. The Monitor generates one per interval
/// and reuses it when retrying after a network failure; the second insert
/// violates `(work_session_id, client_key)` and the route answers with the row
/// that already exists. No queue, no dedupe table, no scheduled reconciliation —
/// one index does it, and it does it correctly under concurrency because it is
/// the database that enforces it.
///
/// It is scoped to the work session rather than being globally unique on
/// purpose: it is a value a client chose, so it must not be able to collide with
/// — or overwrite — another agent's interval. A key can only ever match a row
/// inside the shift the server itself resolved for the authenticated device.
model ActivityInterval {
  id String @id @default(cuid())

  /// Whose activity. Server-derived from the authenticated monitor device;
  /// there is no user id in the request body that reaches this column. Cascade,
  /// matching `screenshots` — monitoring data about a deleted account has
  /// nobody to be shown for.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The shift this happened during. Resolved server-side from the portal's own
  /// view of the agent's open session, exactly as a screenshot's is. Required,
  /// not optional: activity outside a work session is activity that was not
  /// being tracked, and the API refuses it.
  workSessionId String      @map("work_session_id")
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)

  /// The observed window, in UTC. Client-reported and then validated against
  /// the server's clock *and* against the shift's own bounds — an interval that
  /// claims to have happened before the shift started, or hours from now, is
  /// refused rather than clamped, because unlike a screenshot's `captured_at`
  /// there is no salvageable artefact behind it.
  startedAt DateTime @map("started_at")
  endedAt   DateTime @map("ended_at")

  /// Whole seconds. Stored rather than derived for the reason
  /// `work_sessions.duration_seconds` is: every report sums it, and summing an
  /// integer column beats subtracting two timestamps a million times. Written
  /// from `ended_at - started_at` in one place, so the three cannot disagree.
  durationSeconds Int @map("duration_seconds")

  /// Aggregate event counts for the window. Counts, not events.
  keyboardActivityCount Int @map("keyboard_activity_count")
  mouseActivityCount    Int @map("mouse_activity_count")

  /// 0–100, computed by the server. See `lib/activityRules.ts`.
  activityPercentage Int @map("activity_percentage")

  /// The client's idempotency key for this interval. See the note above.
  clientKey String @map("client_key")

  /// When the server received it. `started_at` is when the activity happened;
  /// the two together are what expose a workstation submitting late or with a
  /// wrong clock, exactly as they do for screenshots.
  createdAt DateTime @default(now()) @map("created_at")

  /// The duplicate protection. Scoped to the shift — see the note above.
  @@unique([workSessionId, clientKey])
  /// The three shapes of query this table actually has: one agent over a window
  /// (every report and the agent's own screen), everything in one shift (the
  /// session detail), and a range across everybody (the admin dashboard).
  @@index([userId, startedAt])
  @@index([workSessionId, startedAt])
  @@index([startedAt])
  @@index([createdAt])
  @@map("activity_intervals")
}

/// One stretch of time an application was in the foreground on a workstation.
///
/// The third thing a work session can contain, beside screenshots and activity
/// intervals, and the same shape as both: server-attributed, bounded, and
/// describing a shift rather than making one.
///
///     Work Session
///       ├── Activity Intervals   (how much input)
///       ├── Screenshots          (what the screen looked like)
///       └── App Usage            (which application had the foreground)
///
/// **What is deliberately not here.** No window titles, no URLs, no document
/// names, no keystrokes, no typed text, no mouse coordinates, no screenshots.
/// Two labels — the process and the application it belongs to — and the window
/// the process held the foreground for. As with `activity_intervals`, that is
/// not a gap a later version might fill: these are the only columns app usage
/// data has to go in, so there is nowhere for a window title to be stored even
/// if a workstation tried to send one. The upload route refuses a name that
/// looks like a URL and truncates nothing — it refuses (`lib/appUsageRules.ts`).
///
/// **No application is classified.** There is no `productive` column, no
/// category, no score and no weight. The table records how long something was
/// on screen; deciding whether that was a good use of the time is a judgement
/// this system does not make and has no column to record. `Chrome` is not
/// productive, `WhatsApp` is not a distraction, and the existing productivity
/// score (`lib/productivity.ts`) does not read this table at all.
///
/// **Nothing identifying comes from the request.** `user_id` is the account the
/// bearer token resolved to, `work_session_id` is the portal's own view of that
/// agent's open shift, and `monitor_device_id` is the device row that
/// authenticated — exactly as for a screenshot and an activity interval. There
/// is no field in a submission that names a user or a shift.
model AppUsage {
  id String @id @default(cuid())

  /// Whose workstation. Cascade, matching `screenshots` and
  /// `activity_intervals`: monitoring data about a deleted account has nobody
  /// to be reported for.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The shift it happened during. Required, not optional, for the reason
  /// `activity_intervals.work_session_id` is: usage outside a work session is
  /// usage that was not being tracked, and the API refuses it rather than
  /// filing it against nothing.
  workSessionId String      @map("work_session_id")
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)

  /// Which workstation reported it. Nullable with `SetNull`, exactly as
  /// `screenshots.monitor_device_id` is and for the same reason: device rows are
  /// revoked on sign-out and deleted by the housekeeping sweep, and a usage
  /// record must outlive the laptop it came from.
  deviceId String?        @map("monitor_device_id")
  device   MonitorDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  /// The executable, without its directory — `chrome.exe`, not
  /// `C:\Users\umar\AppData\…\chrome.exe`. The path is stripped on the way in
  /// (`lib/appUsageRules.ts`): a full path carries the account name and the
  /// layout of somebody's disk, neither of which this feature has any use for.
  processName String @map("process_name")

  /// The human label the reports group by — `Google Chrome`, `WhatsApp`.
  /// Client-supplied, bounded in length and refused if it looks like a URL or
  /// carries control characters. It is a *label*, never a window title.
  applicationName String @map("application_name")

  /// The foreground window, in UTC. Validated against the server's clock and
  /// against the shift's own start, and refused rather than clamped — the same
  /// rule `activity_intervals` follows, because a segment *is* its timestamps
  /// and clamping would invent time nobody observed.
  startedAt DateTime @map("started_at")
  endedAt   DateTime @map("ended_at")

  /// Whole seconds, derived from the two timestamps on the server. Stored
  /// rather than computed on read for the reason every other duration in this
  /// schema is: `sum(duration_seconds)` over an indexed range is what every
  /// report does, several hundred thousand times.
  durationSeconds Int @map("duration_seconds")

  /// The client's idempotency key for this segment.
  ///
  /// **Unique on its own**, not scoped to the shift the way an activity
  /// interval's is. A resend of a segment the server already holds therefore
  /// cannot become a second row under any circumstances, including the one the
  /// scoped index misses — a retry that arrives after the agent's shift rolled
  /// over, where the same key would resolve to a different session. The cost is
  /// that two workstations colliding on one key is a refusal rather than a
  /// silent second row, which is the right way round: see the note on
  /// `client_key_conflict` in `lib/appUsage.ts`.
  clientKey String @unique @map("client_key")

  /// When the server received it. `started_at` is when it happened; the two
  /// together are what expose a workstation reporting late or with a wrong
  /// clock, exactly as they do for screenshots and intervals.
  createdAt DateTime @default(now()) @map("created_at")

  /// The four shapes of query this table has. One agent over a window (the
  /// employee view), everything in one shift (the session detail and the
  /// timeline), a range across everybody (the team report), and one application
  /// across everybody (the application filter) — which is why that index leads
  /// with the name and carries the instant, so the filter and the window are
  /// served by one index rather than by a scan after a lookup.
  @@index([userId, startedAt])
  @@index([workSessionId, startedAt])
  @@index([startedAt])
  @@index([applicationName, startedAt])
  @@index([deviceId])
  @@map("app_usage")
}

/// One manual correction an administrator made to a work session, kept forever.
///
/// **Why the correction is applied to the session rather than layered over it.**
/// The alternative — leaving `work_sessions` untouched and storing a delta that
/// every report adds back — was considered and rejected. It would mean every one
/// of the aggregate queries in `lib/performance.ts` and `lib/timeTracking.ts`
/// growing a join and a correction term, and the first one written without it
/// would report an uncorrected figure that looks exactly like a corrected one.
/// So the shift row holds the current truth and this table holds the history:
/// one place to read a number, one place to read how it got that way.
///
/// **Nothing is silently overwritten.** The row records the whole before and the
/// whole after, not just the field that moved, so a correction can be read
/// without joining back to a session that may have been corrected again since.
/// Rows are never updated and never deleted by the application.
///
/// **Only an administrator can create one**, enforced by `apiAdmin()` at the
/// route. There is no agent-facing path that writes here or to `work_sessions`.
model TimeAdjustment {
  id String @id @default(cuid())

  /// The administrator who made the change. Restrict, matching
  /// `password_resets.issued_by_user_id` and for the identical reason: the
  /// record of who altered somebody else's recorded hours must not be removable
  /// by deleting an account. `describeUserFootprint` counts these so the refusal
  /// says so in words rather than as a foreign-key violation.
  adminId String @map("admin_user_id")
  admin   User   @relation("TimeAdjustmentAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  /// Whose time was corrected. Cascade, because `work_sessions` cascades with
  /// its user and this row points at one — the audit trail for a shift cannot
  /// outlive the shift it describes.
  userId String @map("user_id")
  user   User   @relation("TimeAdjustmentSubject", fields: [userId], references: [id], onDelete: Cascade)

  workSessionId String      @map("work_session_id")
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)

  /// The shift exactly as it was before the change.
  previousStartedAt       DateTime  @map("previous_started_at")
  previousEndedAt         DateTime? @map("previous_ended_at")
  previousDurationSeconds Int?      @map("previous_duration_seconds")

  /// And exactly as it was left.
  newStartedAt       DateTime  @map("new_started_at")
  newEndedAt         DateTime? @map("new_ended_at")
  newDurationSeconds Int?      @map("new_duration_seconds")

  /// Required, and required to be non-empty by the route. A correction with no
  /// stated reason is indistinguishable from tampering six months later.
  reason String

  createdAt DateTime @default(now()) @map("created_at")

  /// "What has been corrected for this agent" (the detail screen), "for this
  /// shift" (the session row's own history), and "recently, by anyone" (the
  /// audit list).
  @@index([userId, createdAt])
  @@index([workSessionId])
  @@index([adminId, createdAt])
  @@index([createdAt])
  @@map("time_adjustments")
}

/// A one-time credential an administrator hands to someone who cannot sign in.
///
/// A separate table rather than four more columns on `users`, for the same
/// reason sessions are a separate table: these rows are short-lived, there can
/// be a history of them, and none of it belongs in the record that every page
/// load reads. Expired and used rows stay as the only trace that a reset
/// happened — the code itself is never recoverable from them.
///
/// **The code is not stored.** `codeHash` is the same salted scrypt format
/// `lib/password.ts` writes for passwords, so a database dump yields no usable
/// code, and an administrator with SQL access learns nothing they could hand to
/// anyone. Verification is a hash comparison against the one active row for the
/// account, which is why a slow hash is affordable here where it would not be
/// if codes had to be looked up *by* their hash.
model PasswordReset {
  id String @id @default(cuid())

  /// Whose account this unlocks. Cascade: a deleted user's pending code must
  /// not outlive them.
  userId String @map("user_id")
  user   User   @relation("PasswordResetSubject", fields: [userId], references: [id], onDelete: Cascade)

  /// scrypt hash of the code, in `lib/password.ts` format.
  codeHash String @map("code_hash")

  /// The administrator who issued it. Restrict, matching recordings: accounts
  /// are disabled rather than deleted, and the record of who reset whose
  /// password should not be removable by deleting a user.
  issuedById String @map("issued_by_user_id")
  issuedBy   User   @relation("PasswordResetIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  /// Enforced server-side on every use. 30 minutes from issue.
  expiresAt DateTime  @map("expires_at")
  /// Stamped once, when the code is redeemed. A non-null value here is what
  /// makes the code single-use — it is never deleted on redemption, so a
  /// replay finds a row that says "already used" rather than no row at all.
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  /// The redemption path looks up "the active code for this user", and the
  /// housekeeping sweep ranges over the clock.
  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

/// A sign-in that has cleared the password step and is waiting on an emailed
/// code. It is *not* a session and grants nothing — see `lib/loginOtp.ts`.
///
/// **Why a separate table rather than a half-built `sessions` row.** A row in
/// `sessions` is, by definition of every guard in the app, an authenticated
/// browser: `getSessionUser` looks up exactly that table and hands back a user.
/// Putting a "not finished yet" row in it would mean every one of those guards
/// had to learn a second state, and the first one that forgot would be an
/// authentication bypass. This table is unreachable from `getSessionUser` at
/// all, so a pending row cannot become access by omission.
///
/// **The browser holds a challenge token, never the user id.** The pending
/// cookie is 32 random bytes whose SHA-256 is `challengeHash` here — the same
/// construction `sessions` uses, and for the same reason: a database dump
/// yields nothing replayable, and the client cannot name whose sign-in it is
/// resuming. That cookie is deliberately a *browser-session* cookie with no
/// expiry attribute, so closing the browser mid-verification discards it; the
/// five-minute `expiresAt` here is what actually enforces the window.
///
/// **The code is not stored.** `codeHash` is the salted scrypt output
/// `lib/password.ts` writes, exactly as `password_resets` does. Six digits is
/// only ~20 bits, which is precisely why the other three columns exist:
/// `attempts` caps guessing at five, `expiresAt` closes the window at five
/// minutes, and `usedAt` makes redemption single-use. Rate limiting, not
/// entropy, is what makes a 6-digit code safe, and all three limits are checked
/// server-side on every attempt.
///
/// A resend writes a *new* row and pulls the previous row's `expiresAt` back to
/// now (`issueLoginOtp`), so "send me another" is never "now two codes work".
/// The rows share one `challengeHash` for the life of the pending sign-in,
/// which is what lets the cooldown be read off the newest row's `createdAt`.
model LoginOtp {
  id String @id @default(cuid())

  /// Whose sign-in this is. Cascade: a pending code for a deleted account can
  /// unlock nothing and must not outlive them.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 hex of the pending-verification cookie. Not unique — a resend adds
  /// a row under the same challenge.
  challengeHash String @map("challenge_hash")

  /// scrypt hash of the six digits, in `lib/password.ts` format.
  codeHash String @map("code_hash")

  /// Five minutes from issue, enforced on the server on every attempt.
  expiresAt DateTime @map("expires_at")

  /// Incorrect guesses so far. At `OTP_MAX_ATTEMPTS` the row is expired on the
  /// spot and a new code has to be requested.
  attempts Int @default(0)

  /// Stamped once, on the verification that creates the session. Kept rather
  /// than deleted, so a replayed code finds "already used" instead of no row.
  usedAt DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  /// Verification and resend both look up "the newest live row for this
  /// challenge"; the sweep ranges over the clock.
  @@index([challengeHash, createdAt])
  @@index([userId])
  @@index([expiresAt])
  @@map("login_otps")
}

/// A signed-in browser.
///
/// Server-side sessions rather than a self-contained signed token, because
/// logout has to be real: deleting the row ends the session everywhere at
/// once, and a stolen cookie replayed after logout finds nothing. A JWT would
/// stay valid in an attacker's hands until it expired, whatever the app did.
///
/// Only the SHA-256 of the token is stored. The plaintext exists solely in the
/// user's cookie, so a leaked database dump does not hand over live sessions.
model Session {
  id String @id @default(cuid())

  /// SHA-256 hex of the cookie value. Unique, so a token maps to one session.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  /// Cascade: deleting a user ends their sessions in the same statement, so an
  /// account cannot be removed while a live cookie for it still works.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Idle expiry, pushed forward as the session is used (see `lib/session.ts`).
  expiresAt         DateTime @map("expires_at")
  /// Hard ceiling set at sign-in. Rolling expiry can never move past this, so
  /// a permanently-open tab still has to re-authenticate eventually.
  absoluteExpiresAt DateTime @map("absolute_expires_at")

  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  /// User agent and IP as they were at sign-in — enough to recognise a session
  /// in a list, deliberately not enough to be a tracking log.
  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
